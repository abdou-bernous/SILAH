SECRET_KEY=your-secret-key-here
DEBUG=True

# Comma-separated list, e.g. api.silah.dz — leave as * only in dev
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3100

# Database: leave all DB_* blank to use SQLite locally (zero setup).
# For Postgres, EITHER set DATABASE_URL OR fill in the individual DB_* vars below — not both.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Email: leave EMAIL_HOST blank to print emails to the console (dev default).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SILAH <noreply@silah.dz>
